#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>


&mt {
    flavor = "hold-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <125>;
};


&mmv {
  time-to-max-speed-ms = <500>;
  acceleration-exponent = <2>;
};


#define HM_MULTI(label, mods) \
    label: label { \
      compatible = "zmk,behavior-macro-one-param"; \
      #binding-cells = <1>; \
      wait-ms = <10>; \
      tap-ms = <10>; \
      bindings \
        = <&macro_press mods> \
        , <&macro_param_1to1>, <&macro_tap &kp MACRO_PLACEHOLDER> \
        , <&macro_pause_for_release> \
        , <&macro_release mods> \
        ; \
    };

/ {
  behaviors {
    hm: homerow_mods {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "balanced";
	  require-prior-idle-ms = <50>;
      tapping-term-ms = <150>;
      quick-tap-ms = <150>;
      bindings =  <&kp>, <&kp>;
    };

    rst_boot: reset_or_bootloader {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "tap-preferred";
      tapping-term-ms = <1000>;
      bindings = <&bootloader>, <&sys_reset>;
    };

    // Used by the home-row-mod chord combos below: holds the modifier
    // (param 1), taps the key (param 2), then keeps the modifier held until
    // the combo is released. Combined with slow-release on the combo, this
    // means you can keep the home-row key held and keep tapping other keys
    // (e.g. Cmd+Tab Tab Tab, Ctrl+Z Z Z) and they'll still be modified.
    hm_chord: home_row_mod_chord {
      compatible = "zmk,behavior-macro-two-param";
      #binding-cells = <2>;
      wait-ms = <10>;
      tap-ms = <10>;
      bindings
        = <&macro_param_1to1>, <&macro_press &kp MACRO_PLACEHOLDER>
        , <&macro_param_2to1>, <&macro_tap &kp MACRO_PLACEHOLDER>
        , <&macro_pause_for_release>
        , <&macro_param_1to1>, <&macro_release &kp MACRO_PLACEHOLDER>
        ;
    };

    // Same idea as hm_chord, but for chords with several home-row mods:
    // one macro per modifier set, taking the key to tap as its parameter.
    // Named by mods: a=Alt g=Gui/Cmd s=Shift c=Ctrl.
    HM_MULTI(hm_ag, &kp LALT &kp LGUI)
    HM_MULTI(hm_as, &kp LALT &kp LSHIFT)
    HM_MULTI(hm_ac, &kp LALT &kp LCTRL)
    HM_MULTI(hm_gs, &kp LGUI &kp LSHIFT)
    HM_MULTI(hm_gc, &kp LGUI &kp LCTRL)
    HM_MULTI(hm_sc, &kp LSHIFT &kp LCTRL)
    HM_MULTI(hm_ags, &kp LALT &kp LGUI &kp LSHIFT)
    HM_MULTI(hm_agc, &kp LALT &kp LGUI &kp LCTRL)
    HM_MULTI(hm_asc, &kp LALT &kp LSHIFT &kp LCTRL)
    HM_MULTI(hm_gsc, &kp LGUI &kp LSHIFT &kp LCTRL)
    HM_MULTI(hm_agsc, &kp LALT &kp LGUI &kp LSHIFT &kp LCTRL)
  };
};


/*
 * Home-row-mod chords.
 *
 * If one or more home-row mod keys and another (non-mod-tap) key all go
 * down within HMC_TIMEOUT_MS of the first press, in any order, send the
 * modified key, skipping the hold-tap's timing decision entirely.
 *
 * HMC_IDLE_MS keeps these combos switched off mid-typing: they only arm if
 * no other key was pressed in the previous HMC_IDLE_MS, so fast rolls inside
 * words (e.g. "fr", "so") aren't turned into shortcuts.
 */
#define HMC_TIMEOUT_MS 30
#define HMC_IDLE_MS 150

#define HMC_ONE(id, mod_positions, behavior, name, pos, kc) \
    hmc_##id##_##name { \
      timeout-ms = <HMC_TIMEOUT_MS>; \
      require-prior-idle-ms = <HMC_IDLE_MS>; \
      slow-release; \
      layers = <0>; \
      key-positions = <mod_positions pos>; \
      bindings = <behavior kc>; \
    };

// Home-row mod positions: A=25 S=26 D=27 F=28 | J=31 K=32 L=33 ;=34
//
// Single-mod chords keep the exact (left/right) modifier of the key.
// Multi-mod chords cover every set of 2-4 *different* modifiers, using
// either hand's key for each, and always send the left-hand modifiers.
#define HMC(name, pos, kc) \
    HMC_ONE(lalt,   25, &hm_chord LEFT_ALT,  name, pos, kc) \
    HMC_ONE(lmeta,  26, &hm_chord LEFT_META, name, pos, kc) \
    HMC_ONE(lshift, 27, &hm_chord LSHIFT,    name, pos, kc) \
    HMC_ONE(lctrl,  28, &hm_chord LCTRL,     name, pos, kc) \
    HMC_ONE(rctrl,  31, &hm_chord RCTRL,     name, pos, kc) \
    HMC_ONE(rshift, 32, &hm_chord RSHIFT,    name, pos, kc) \
    HMC_ONE(rmeta,  33, &hm_chord RMETA,     name, pos, kc) \
    HMC_ONE(ralt,   34, &hm_chord RALT,      name, pos, kc) \
    HMC_ONE(a_s, 25 26, &hm_ag, name, pos, kc) \
    HMC_ONE(a_l, 25 33, &hm_ag, name, pos, kc) \
    HMC_ONE(s_scln, 26 34, &hm_ag, name, pos, kc) \
    HMC_ONE(l_scln, 33 34, &hm_ag, name, pos, kc) \
    HMC_ONE(a_d, 25 27, &hm_as, name, pos, kc) \
    HMC_ONE(a_k, 25 32, &hm_as, name, pos, kc) \
    HMC_ONE(d_scln, 27 34, &hm_as, name, pos, kc) \
    HMC_ONE(k_scln, 32 34, &hm_as, name, pos, kc) \
    HMC_ONE(a_f, 25 28, &hm_ac, name, pos, kc) \
    HMC_ONE(a_j, 25 31, &hm_ac, name, pos, kc) \
    HMC_ONE(f_scln, 28 34, &hm_ac, name, pos, kc) \
    HMC_ONE(j_scln, 31 34, &hm_ac, name, pos, kc) \
    HMC_ONE(s_d, 26 27, &hm_gs, name, pos, kc) \
    HMC_ONE(s_k, 26 32, &hm_gs, name, pos, kc) \
    HMC_ONE(d_l, 27 33, &hm_gs, name, pos, kc) \
    HMC_ONE(k_l, 32 33, &hm_gs, name, pos, kc) \
    HMC_ONE(s_f, 26 28, &hm_gc, name, pos, kc) \
    HMC_ONE(s_j, 26 31, &hm_gc, name, pos, kc) \
    HMC_ONE(f_l, 28 33, &hm_gc, name, pos, kc) \
    HMC_ONE(j_l, 31 33, &hm_gc, name, pos, kc) \
    HMC_ONE(d_f, 27 28, &hm_sc, name, pos, kc) \
    HMC_ONE(d_j, 27 31, &hm_sc, name, pos, kc) \
    HMC_ONE(f_k, 28 32, &hm_sc, name, pos, kc) \
    HMC_ONE(j_k, 31 32, &hm_sc, name, pos, kc) \
    HMC_ONE(a_s_d, 25 26 27, &hm_ags, name, pos, kc) \
    HMC_ONE(a_s_k, 25 26 32, &hm_ags, name, pos, kc) \
    HMC_ONE(a_d_l, 25 27 33, &hm_ags, name, pos, kc) \
    HMC_ONE(a_k_l, 25 32 33, &hm_ags, name, pos, kc) \
    HMC_ONE(s_d_scln, 26 27 34, &hm_ags, name, pos, kc) \
    HMC_ONE(s_k_scln, 26 32 34, &hm_ags, name, pos, kc) \
    HMC_ONE(d_l_scln, 27 33 34, &hm_ags, name, pos, kc) \
    HMC_ONE(k_l_scln, 32 33 34, &hm_ags, name, pos, kc) \
    HMC_ONE(a_s_f, 25 26 28, &hm_agc, name, pos, kc) \
    HMC_ONE(a_s_j, 25 26 31, &hm_agc, name, pos, kc) \
    HMC_ONE(a_f_l, 25 28 33, &hm_agc, name, pos, kc) \
    HMC_ONE(a_j_l, 25 31 33, &hm_agc, name, pos, kc) \
    HMC_ONE(s_f_scln, 26 28 34, &hm_agc, name, pos, kc) \
    HMC_ONE(s_j_scln, 26 31 34, &hm_agc, name, pos, kc) \
    HMC_ONE(f_l_scln, 28 33 34, &hm_agc, name, pos, kc) \
    HMC_ONE(j_l_scln, 31 33 34, &hm_agc, name, pos, kc) \
    HMC_ONE(a_d_f, 25 27 28, &hm_asc, name, pos, kc) \
    HMC_ONE(a_d_j, 25 27 31, &hm_asc, name, pos, kc) \
    HMC_ONE(a_f_k, 25 28 32, &hm_asc, name, pos, kc) \
    HMC_ONE(a_j_k, 25 31 32, &hm_asc, name, pos, kc) \
    HMC_ONE(d_f_scln, 27 28 34, &hm_asc, name, pos, kc) \
    HMC_ONE(d_j_scln, 27 31 34, &hm_asc, name, pos, kc) \
    HMC_ONE(f_k_scln, 28 32 34, &hm_asc, name, pos, kc) \
    HMC_ONE(j_k_scln, 31 32 34, &hm_asc, name, pos, kc) \
    HMC_ONE(s_d_f, 26 27 28, &hm_gsc, name, pos, kc) \
    HMC_ONE(s_d_j, 26 27 31, &hm_gsc, name, pos, kc) \
    HMC_ONE(s_f_k, 26 28 32, &hm_gsc, name, pos, kc) \
    HMC_ONE(s_j_k, 26 31 32, &hm_gsc, name, pos, kc) \
    HMC_ONE(d_f_l, 27 28 33, &hm_gsc, name, pos, kc) \
    HMC_ONE(d_j_l, 27 31 33, &hm_gsc, name, pos, kc) \
    HMC_ONE(f_k_l, 28 32 33, &hm_gsc, name, pos, kc) \
    HMC_ONE(j_k_l, 31 32 33, &hm_gsc, name, pos, kc) \
    HMC_ONE(a_s_d_f, 25 26 27 28, &hm_agsc, name, pos, kc) \
    HMC_ONE(a_s_d_j, 25 26 27 31, &hm_agsc, name, pos, kc) \
    HMC_ONE(a_s_f_k, 25 26 28 32, &hm_agsc, name, pos, kc) \
    HMC_ONE(a_s_j_k, 25 26 31 32, &hm_agsc, name, pos, kc) \
    HMC_ONE(a_d_f_l, 25 27 28 33, &hm_agsc, name, pos, kc) \
    HMC_ONE(a_d_j_l, 25 27 31 33, &hm_agsc, name, pos, kc) \
    HMC_ONE(a_f_k_l, 25 28 32 33, &hm_agsc, name, pos, kc) \
    HMC_ONE(a_j_k_l, 25 31 32 33, &hm_agsc, name, pos, kc) \
    HMC_ONE(s_d_f_scln, 26 27 28 34, &hm_agsc, name, pos, kc) \
    HMC_ONE(s_d_j_scln, 26 27 31 34, &hm_agsc, name, pos, kc) \
    HMC_ONE(s_f_k_scln, 26 28 32 34, &hm_agsc, name, pos, kc) \
    HMC_ONE(s_j_k_scln, 26 31 32 34, &hm_agsc, name, pos, kc) \
    HMC_ONE(d_f_l_scln, 27 28 33 34, &hm_agsc, name, pos, kc) \
    HMC_ONE(d_j_l_scln, 27 31 33 34, &hm_agsc, name, pos, kc) \
    HMC_ONE(f_k_l_scln, 28 32 33 34, &hm_agsc, name, pos, kc) \
    HMC_ONE(j_k_l_scln, 31 32 33 34, &hm_agsc, name, pos, kc)


/ {
  combos {
    compatible = "zmk,combos";
    combo_F9 {
      timeout-ms = <50>;
      key-positions = <53 54>;
      bindings = <&kp F9>;
      require-prior-idle-ms = <150>;
    };

	mouse-layer {
	  timeout-ms = <50>;
	  key-positions = <52 55>;
	  bindings = <&to 6>;
	  require-prior-idle-ms = <150>;
    };

    // Home-row-mod chords: every home-row mod with every non-mod-tap key
    // on the Typing layer.
    HMC(esc,   0, ESC)
    HMC(n1,    1, N1)
    HMC(n2,    2, N2)
    HMC(n3,    3, N3)
    HMC(n4,    4, N4)
    HMC(n5,    5, N5)
    HMC(n6,    6, N6)
    HMC(n7,    7, N7)
    HMC(n8,    8, N8)
    HMC(n9,    9, N9)
    HMC(n0,   10, N0)
    HMC(grv,  11, GRAVE)
    HMC(tab,  12, TAB)
    HMC(q,    13, Q)
    HMC(w,    14, W)
    HMC(e,    15, E)
    HMC(r,    16, R)
    HMC(t,    17, T)
    HMC(y,    18, Y)
    HMC(u,    19, U)
    HMC(i,    20, I)
    HMC(o,    21, O)
    HMC(p,    22, P)
    HMC(minus,23, MINUS)
    HMC(g,    29, G)
    HMC(h,    30, H)
    HMC(sqt,  35, SQT)
    HMC(z,    37, Z)
    HMC(x,    38, X)
    HMC(c,    39, C)
    HMC(v,    40, V)
    HMC(b,    41, B)
    HMC(pgup, 42, PAGE_UP)
    HMC(pgdn, 43, PAGE_DOWN)
    HMC(n,    44, N)
    HMC(m,    45, M)
    HMC(comma,46, COMMA)
    HMC(dot,  47, DOT)
    HMC(fslh, 48, FSLH)
    HMC(bslh, 49, BACKSLASH)
    HMC(spc,  54, SPACE)
    HMC(bspc, 55, BACKSPACE)
  };
};


/ {
  conditional_layers {
    compatible = "zmk,conditional-layers";
    extra_functions {
      if-layers = <2 3>;
      then-layer = <4>;
    };
  };
};


/ {
    keymap {
        compatible = "zmk,keymap";

        Typing { // 0
            bindings = <
&kp ESC  &kp N1          &kp N2           &kp N3        &kp N4       &kp N5                                   &kp N6         &kp N7       &kp N8        &kp N9       &kp N0              &kp GRAVE
&kp TAB  &kp Q           &kp W            &kp E         &kp R        &kp T                                    &kp Y          &kp U        &kp I         &kp O        &kp P               &kp MINUS
&none    &hm LEFT_ALT A  &hm LEFT_META S  &hm LSHIFT D  &hm LCTRL F  &kp G                                    &kp H          &hm RCTRL J  &hm RSHIFT K  &hm RMETA L  &hm RALT SEMICOLON  &kp SQT
&none    &kp Z           &kp X            &kp C         &kp V        &kp B   &kp PAGE_UP       &kp PAGE_DOWN  &kp N          &kp M        &kp COMMA     &kp DOT      &kp FSLH            &kp BACKSLASH
                                          &none         &mo 3        &mo 1   &mt LSHIFT RET    &kp SPACE      &kp BACKSPACE  &mo 2        &none
            >;
        };

        Symbols { // 1
            bindings = <
&none  &none  &none          &none         &none      &none                           &none          &kp LT    &kp GT    &none        &none  &none
&none  &none  &kp PIPE       &kp PLUS      &kp MINUS  &kp QMARK                       &kp TILDE      &kp LBRC  &kp RBRC  &kp PERCENT  &none  &none
&none  &none  &kp AMPERSAND  &kp ASTERISK  &kp SLASH  &kp EXCL                        &kp EQUAL      &kp LPAR  &kp RPAR  &kp COLON    &none  &none
&none  &none  &kp AT         &kp HASH      &kp DOLLAR &kp CARET  &kp HOME    &kp END  &kp UNDER      &kp LBKT  &kp RBKT  &none        &none  &none
                             &none         &none      &trans     &trans      &trans   &kp DEL        &none     &none
            >;
        };

        Functions { // 2
            bindings = <
&none       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                                  &none  &none     &none     &none      &none  &none
&none       &kp F1        &kp F2        &kp F3        &kp F4        &kp C_VOLUME_UP                               &none  &none     &kp UP    &none      &none  &none
&none       &kp F5        &kp F6        &kp F7        &kp F8        &kp C_VOL_DN                                  &none  &kp LEFT  &kp DOWN  &kp RIGHT  &none  &none
&bt BT_CLR  &kp F9        &kp F10       &kp F11       &kp F12       &none            &rst_boot 0 0 &rst_boot 0 0  &none  &none     &none     &none      &none  &none
                                        &none         &trans        &none            &none         &none          &none  &trans    &none
            >;
        };

        Numpad { // 3
            bindings = <
&none  &none  &none  &none  &none   &none                    &kp MINUS   &kp STAR  &kp FSLH  &none   &none  &none
&none  &none  &none  &none  &none   &none                    &kp PLUS    &kp N7    &kp N8    &kp N9  &none  &none
&none  &none  &none  &none  &none   &none                    &kp N0      &kp N4    &kp N5    &kp N6  &none  &none
&none  &none  &none  &none  &none   &none  &none    &none    &kp DOT     &kp N1    &kp N2    &kp N3  &none  &none
                     &none  &trans  &none  &none    &kp RET  &trans      &trans     &none
            >;
        };

        ExtraFunctions { // 4
          bindings = <
&none &none   &none   &none   &none   &none                 &none &none &none &none &none &none
&none &kp F13 &kp F14 &kp F15 &kp F16 &none                 &none &none &none &none &none &none
&none &kp F17 &kp F18 &kp F19 &kp F20 &none                 &none &none &none &none &none &none
&none &kp F21 &kp F22 &kp F23 &kp F24 &none &none     &none &none &none &none &none &none &none
                      &none   &none   &none &none     &none &none &none &none
          >;
        };

        Mouse_Slow {  // 5
          bindings = <
 	&none &none &none &none &none &none                 &none &msc MOVE_X(-5) &none            &msc MOVE_X(5) &none &none
	&none &none &mkp MCLK &mkp RCLK &mkp LCLK &none                 &none &msc MOVE_Y(-5) &mmv MOVE_Y(-200) &msc MOVE_Y(5) &none &none
	&none &to 0 &to 5 &to 6 &to 7 &none                 &none &mmv MOVE_X(-200) &mmv MOVE_Y(200)  &mmv MOVE_X(200) &none &none
	&none &none &none &none &none &none &none     &none &none &mkp LCLK        &mkp RCLK        &mkp MCLK       &none &none
                      &none &none &to 0 &none     &none &to 0 &none            &none
          >;
        };

        Mouse_Med {  // 6
          bindings = <
 	&none &none &none &none &none &none                 &none &msc MOVE_X(-10) &none            &msc MOVE_X(10) &none &none
	&none &none &mkp MCLK &mkp RCLK &mkp LCLK &none                 &none &msc MOVE_Y(-10) &mmv MOVE_Y(-400) &msc MOVE_Y(10) &none &none
	&none &to 0 &to 5 &to 6 &to 7 &none                 &none &mmv MOVE_X(-400) &mmv MOVE_Y(400)  &mmv MOVE_X(400) &none &none
	&none &none &none &none &none &none &none     &none &none &mkp LCLK        &mkp RCLK        &mkp MCLK       &none &none
                      &none &none &to 0 &none     &none &to 0 &none            &none
          >;
        };

        Mouse_Fast {  // 7
          bindings = <
 	&none &none &none &none &none &none                 &none &msc MOVE_X(-20) &none            &msc MOVE_X(20) &none &none
	&none &none &mkp MCLK &mkp RCLK &mkp LCLK &none                 &none &msc MOVE_Y(-20) &mmv MOVE_Y(-800) &msc MOVE_Y(20) &none &none
	&none &to 0 &to 5 &to 6 &to 7 &none                 &none &mmv MOVE_X(-800) &mmv MOVE_Y(800)  &mmv MOVE_X(800) &none &none
	&none &none &none &none &none &none &none     &none &none &mkp LCLK        &mkp RCLK        &mkp MCLK       &none &none
                      &none &none &to 0 &none     &none &to 0 &none            &none
          >;
        };
    };
};
