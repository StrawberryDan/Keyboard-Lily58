#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>


&mt {
    flavor = "hold-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <125>;
};


/ {
  behaviors {
    hm: homerow_mods {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "balanced";
      tapping-term-ms = <100>;
      quick-tap-ms = <50>;
      bindings =  <&kp>, <&kp>;
    };

    rst_boot: reset_or_bootloader {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "tap-preferred";
      tapping-term-ms = <1000>;
      bindings = <&bootloader>, <&sys_reset>;
    };
  };
};


/ {
  combos {
    compatible = "zmk,combos";
    combo_F9 {
      timeout-ms = <75>;
      key-positions = <53 54>;
      bindings = <&kp F9>;
      require-prior-idle-ms = <150>;
    };
  };
};


/ {
  conditional_layers {
    compatible = "zmk,conditional-layers";
    extra_functions {
      if-layers = <2 3>;
      then-layer = <4>;
    };
  };
};


/ {
    keymap {
        compatible = "zmk,keymap";

        Typing {
            bindings = <
&kp ESC  &kp N1          &kp N2           &kp N3        &kp N4       &kp N5                                   &kp N6         &kp N7       &kp N8        &kp N9       &kp N0              &kp GRAVE
&kp TAB  &kp Q           &kp W            &kp E         &kp R        &kp T                                    &kp Y          &kp U        &kp I         &kp O        &kp P               &kp MINUS
&none    &hm LEFT_ALT A  &hm LEFT_META S  &hm LSHIFT D  &hm LCTRL F  &kp G                                    &kp H          &hm RCTRL J  &hm RSHIFT K  &hm RMETA L  &hm RALT SEMICOLON  &kp SQT
&none    &kp Z           &kp X            &kp C         &kp V        &kp B   &kp PAGE_UP       &kp PAGE_DOWN  &kp N          &kp M        &kp COMMA     &kp DOT      &kp FSLH            &kp BACKSLASH
                                          &none         &mo 3        &mo 1   &mt LSHIFT RET    &kp SPACE      &kp BACKSPACE  &mo 2        &none
            >;
        };

        Symbols {
            bindings = <
&none  &none  &none          &none         &none      &none                           &none          &kp LT    &kp GT    &none        &none  &none
&none  &none  &kp PIPE       &kp PLUS      &kp MINUS  &kp QMARK                       &kp TILDE      &kp LBRC  &kp RBRC  &kp PERCENT  &none  &none
&none  &none  &kp AMPERSAND  &kp ASTERISK  &kp SLASH  &kp EXCL                        &kp EQUAL      &kp LPAR  &kp RPAR  &kp COLON    &none  &none
&none  &none  &kp AT         &kp HASH      &kp DOLLAR &kp CARET  &kp HOME    &kp END  &kp UNDER      &kp LBKT  &kp RBKT  &none        &none  &none
                             &none         &none      &trans     &trans      &trans   &kp DEL        &none     &none
            >;
        };

        Functions {
            bindings = <
&none       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                                  &none  &none     &none     &none      &none  &none
&none       &kp F1        &kp F2        &kp F3        &kp F4        &kp C_VOLUME_UP                               &none  &none     &kp UP    &none      &none  &none
&none       &kp F5        &kp F6        &kp F7        &kp F8        &kp C_VOL_DN                                  &none  &kp LEFT  &kp DOWN  &kp RIGHT  &none  &none
&bt BT_CLR  &kp F9        &kp F10       &kp F11       &kp F12       &none            &rst_boot 0 0 &rst_boot 0 0  &none  &none     &none     &none      &none  &none
                                        &none         &none         &none            &none         &none          &none  &trans    &none
            >;
        };

        Numpad {
            bindings = <
&none  &none  &none  &none  &none   &none                    &kp MINUS   &kp STAR  &kp FSLH  &none   &none  &none
&none  &none  &none  &none  &none   &none                    &kp PLUS    &kp N7    &kp N8    &kp N9  &none  &none
&none  &none  &none  &none  &none   &none                    &kp N0      &kp N4    &kp N5    &kp N6  &none  &none
&none  &none  &none  &none  &none   &none  &none    &none    &kp DOT     &kp N1    &kp N2    &kp N3  &none  &none
                     &none  &trans  &none  &none    &kp RET  &trans      &none     &none
            >;
        };

        ExtraFunctions {
          bindings = <
&none &none   &none   &none   &none   &none                 &none &none &none &none &none &none
&none &kp F13 &kp F14 &kp F15 &kp F16 &none                 &none &none &none &none &none &none
&none &kp F17 &kp F18 &kp F19 &kp F20 &none                 &none &none &none &none &none &none
&none &kp F21 &kp F22 &kp F23 &kp F24 &none &none     &none &none &none &none &none &none &none
                      &none   &none   &none &none     &none &none &none &none
          >;
        };
    };
};
